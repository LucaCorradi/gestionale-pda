# Configurazione del backend PDA sul server. Si copia in ".env" nella cartella del backend e si compilano i valori vuoti:
#   cp env.production.example .env
#   nano .env
#
# Regole del formato: una variabile per riga, NIENTE spazi attorno al "=", niente virgolette.
# Se una password contiene il carattere "$" va raddoppiato ($$), altrimenti Docker lo scambia per una variabile.
# Il file .env contiene password: non va mai messo in git né dentro il sito (httpdocs).

ENVIRONMENT=PRODUCTION
PORT=8787

# --- Database MySQL del gestionale PDA (quello creato su Plesk, passo 2 della guida) ---
# Il backend gira con la rete del server (network_mode: host), quindi MySQL si raggiunge su 127.0.0.1.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Passepartout: web service SOAP (documenti di magazzino, articoli, personale) ---
PASSEPARTOUT_SOAP_HOST=192.168.0.201
PASSEPARTOUT_SOAP_PORT=7610
PASSEPARTOUT_SOAP_USER=
PASSEPARTOUT_SOAP_PASSWORD=

# Gruppo di Passepartout da cui prendere gli operatori mostrati nei palmari.
# Gli operatori devono avere la scheda "Personale" ed essere nel gruppo. Più gruppi separati da virgola; vuoto = tutti.
PASSEPARTOUT_EMPLOYEES_GROUP=palmarimagazzino

# Magazzini da NON mostrare nei palmari (nomi separati da virgola, maiuscole ininfluenti): per quelli non in uso ma non eliminabili da Passepartout.
PASSEPARTOUT_HIDDEN_WAREHOUSES=Magazzino predefinito

# --- Database di Passepartout (SQL Server, solo lettura: serve solo al grafico delle giacenze) ---
PASSEPARTOUT_DB_HOST=192.168.0.201
PASSEPARTOUT_DB_PORT=3306
PASSEPARTOUT_DB_NAME=PassepartoutMenu
PASSEPARTOUT_DB_USER=
PASSEPARTOUT_DB_PASSWORD=

# --- Database dei frigoriferi (SQL Server Telenet: elenco frigoriferi e temperature) ---
FRIDGES_DB_HOST=192.168.0.104\TELENET_PEGOWISE
FRIDGES_DB_PORT=1433
FRIDGES_DB_NAME=TELENET
FRIDGES_DB_USER=
FRIDGES_DB_PASSWORD=

# --- Indirizzo con cui il browser apre il sito (schema incluso: http:// oppure https://) ---
CLIENT_URL=http://pda.cdf

# --- Etichette barcode: stampante Zebra di rete (ZPL su TCP) ---
# LABEL_PRINTER_HOST vuoto = stampa disattivata. Il server deve raggiungere la stampante in rete.
LABEL_PRINTER_HOST=192.168.0.125
LABEL_PRINTER_PORT=9100
# Prime 2 cifre del barcode EAN-8 (prefisso + codice interno a 5 cifre + controllo)
LABEL_EAN8_PREFIX=99
# Misure dell'etichetta in mm (larghezza x altezza) e risoluzione della stampante
LABEL_WIDTH_MM=50
LABEL_HEIGHT_MM=20
LABEL_PRINTER_DPI=203
# Larghezza del barcode: 3 = circa 25 mm, 2 = circa 17 mm
LABEL_BARCODE_MODULE_DOTS=3
