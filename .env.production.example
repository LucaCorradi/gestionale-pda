# Copia questo file in ".env" (stessa cartella del docker-compose.yml) e compila i valori vuoti:
#   cp .env.production.example .env && nano .env && chmod 600 .env
#
# Una variabile per riga, niente spazi attorno al "=", niente virgolette. Un "$" nelle password va scritto "$$".
# Il file .env contiene password: mai nel repository né nella document root.

PORT=8789

# ---------- Document root (la riempie deploy/aggiorna-server.sh) ----------
# Plesk → pda.lacdf.it → Hosting → "Document root". Deve contenere SOLO il frontend: lo script cancella il resto.
DOCROOT=/var/www/vhosts/lacdf.it/pda.lacdf.it

# Indirizzo con cui il browser apre il sito (schema incluso)
CLIENT_URL=https://pda.lacdf.it

# ---------- Database MySQL del PDA (movimenti, reparti, tipi di operazione) ----------
# L'utente deve essere ammesso da 172.18.20.% (rete cdfnet). Lo schema è in deploy/sql/init.sql.
DB_HOST=172.18.20.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---------- Passepartout: web service SOAP (documenti di magazzino, articoli, personale) ----------
PASSEPARTOUT_SOAP_HOST=192.168.0.201
PASSEPARTOUT_SOAP_PORT=7610
PASSEPARTOUT_SOAP_USER=
PASSEPARTOUT_SOAP_PASSWORD=

# Gruppo di Passepartout da cui prendere gli operatori mostrati nei palmari.
# Gli operatori devono avere la scheda "Personale" ed essere nel gruppo. Più gruppi separati da virgola; vuoto = tutti.
PASSEPARTOUT_EMPLOYEES_GROUP=palmarimagazzino

# Magazzini da NON mostrare nei palmari (nomi separati da virgola, maiuscole ininfluenti).
PASSEPARTOUT_HIDDEN_WAREHOUSES=Magazzino predefinito

# ---------- Database di Passepartout (SQL Server, SOLO LETTURA: serve al grafico delle giacenze) ----------
PASSEPARTOUT_DB_HOST=192.168.0.201
PASSEPARTOUT_DB_PORT=3306
PASSEPARTOUT_DB_NAME=PassepartoutMenu
PASSEPARTOUT_DB_USER=
PASSEPARTOUT_DB_PASSWORD=

# ---------- Database dei frigoriferi (SQL Server Telenet: elenco frigoriferi e temperature) ----------
FRIDGES_DB_HOST=192.168.0.104\TELENET_PEGOWISE
FRIDGES_DB_PORT=1433
FRIDGES_DB_NAME=TELENET
FRIDGES_DB_USER=
FRIDGES_DB_PASSWORD=

# ---------- Etichette barcode: stampante Zebra di rete (ZPL su TCP) ----------
# LABEL_PRINTER_HOST vuoto = stampa disattivata.
LABEL_PRINTER_HOST=192.168.0.125
LABEL_PRINTER_PORT=9100
# Prime 2 cifre del barcode EAN-8 (prefisso + codice interno a 5 cifre + controllo)
LABEL_EAN8_PREFIX=99
# Formati dei barcode a quantità variabile (default config/barcode-variabili.json)
# BARCODE_VARIABILI_FILE=config/barcode-variabili.json
# Misure dell'etichetta in mm e risoluzione della stampante
LABEL_WIDTH_MM=50
LABEL_HEIGHT_MM=20
LABEL_PRINTER_DPI=203
# Larghezza del barcode: 3 = circa 25 mm, 2 = circa 17 mm
LABEL_BARCODE_MODULE_DOTS=3
